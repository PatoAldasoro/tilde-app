# Copiar a .env.local y completar. Paso a paso en docs/SETUP.md. Nunca commitear valores reales.

# URL pública de la app (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts locales y tests (seed, screenshots, e2e, RLS). NUNCA en Vercel ni en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Google Picker (documentos desde Drive). Opcional: sin estas tres, queda solo "Pegar link".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Opcional (solo Vercel): protege /api/keepalive, el ping diario que evita la pausa de Supabase Free.
# Vercel lo envía solo en sus cron jobs. Generar con: openssl rand -hex 32
CRON_SECRET=

# Login de Google en el Supabase local (supabase/config.toml). No hace falta en producción:
# ahí el proveedor se configura en el panel de Supabase.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
